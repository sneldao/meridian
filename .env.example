# --- Model provider selection ---------------------------------------------
# anthropic  -> real Claude calls (demo path)
# featherless-> OpenAI-compatible cheap models for dev iteration
# replay     -> scripted transcript, zero tokens (stage insurance / UI dev)
AGENT_PROVIDER=replay

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
# Defaults are known-good IDs; bump to the 5.5 family if your account has access
MERIDIAN_ORCHESTRATOR_MODEL=claude-sonnet-4-5
MERIDIAN_SPECIALIST_MODEL=claude-haiku-4-5
# MERIDIAN_ORCHESTRATOR_MODEL=claude-sonnet-5-5
# MERIDIAN_SPECIALIST_MODEL=claude-haiku-5-5

# --- Featherless (OpenAI-compatible, dev only) ------------------------------
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_ORCHESTRATOR_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
FEATHERLESS_SPECIALIST_MODEL=Qwen/Qwen3-32B

# --- Firecrawl (optional second science provider) ----------------------------
FIRECRAWL_API_KEY=

# --- Supabase (optional persistence layer) ------------------------------
# Run history/check-ins in the database instead of browser localStorage.
# Table spec in src/tools/supabase.ts; schema in supabase/migrations/
# (supabase link --project-ref <ref> && supabase db push).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Composio → real Google Calendar (optional) ------------------------------
# MCP consumer key (x-consumer-api-key from dashboard → MCP URL) — already
# bound to the connected Google account, no project key or entity id needed.
# proposeMove patches real events; commitPlan writes intervention blocks.
# CALENDAR_BACKEND=fixture forces fixtures even with the key present.
COMPOSIO_API_KEY=
CALENDAR_BACKEND=
GOOGLE_CALENDAR_ID=primary
MERIDIAN_CALENDAR_TZ=Europe/London

# --- ElevenLabs (optional voice layer) ---------------------------------------
# POST /api/voice streams raw PCM per crew member; sentences are synthesized as
# tokens arrive so the crew talks while still "thinking", and utterances are
# cached by content hash (replay runs are instant + free after first synth).
# Multi-voice handoffs go through text-to-dialogue. Defaults in
# src/app/api/voice/route.ts; override a seat with ELEVENLABS_VOICE_<AGENT>
# (e.g. ELEVENLABS_VOICE_PLANNER) or globally with ELEVENLABS_VOICE_ID.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5          — crew chatter (real-time)
# ELEVENLABS_HANDOFF_MODEL=eleven_v4          — narrator voice for the handoff
# ELEVENLABS_DIALOGUE_MODEL=eleven_v3         — multi-voice exchanges (audio tags need v3/v4)
# ELEVENLABS_SEED=4242                         — fixed seed keeps replays deterministic
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0 / ELEVENLABS_SPEED=1 / ELEVENLABS_SPEAKER_BOOST=1

# --- Replay pacing -----------------------------------------------------------
# MS between streamed events in replay mode (default 60; ~300 is narratable).
# REPLAY_BEAT_MS=60

# --- FalkorDB graph memory (optional, Graph Hacks track) ----------------------
# falkor://localhost:6379 — enables cross-run graph memory; unset falls back
# to crew-memory.json. Seed with `bun run seed:graph`.
# FALKORDB_URL=
# MERIDIAN_GRAPH_ID=meridian:demo
