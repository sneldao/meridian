# --- Model provider selection ---------------------------------------------
# featherless-> OpenAI-compatible cheap open models (dev default)
# nebius     -> Nebius Token Factory Nemotron models
# anthropic  -> real Claude calls (highest quality, demo path)
# replay     -> scripted transcript, zero tokens (stage insurance / UI dev)
# A failed live run retries once on AGENT_PROVIDER_FALLBACK, then drains the
# replay transcript — replay is always the end of the chain.
AGENT_PROVIDER=featherless
AGENT_PROVIDER_FALLBACK=nebius

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
# Defaults are known-good IDs; bump to the 5.5 family if your account has access
MERIDIAN_ORCHESTRATOR_MODEL=claude-sonnet-4-5
MERIDIAN_SPECIALIST_MODEL=claude-haiku-4-5
# MERIDIAN_ORCHESTRATOR_MODEL=claude-sonnet-5-5
# MERIDIAN_SPECIALIST_MODEL=claude-haiku-5-5

# --- Featherless (OpenAI-compatible, dev default) ---------------------------
# Model IDs must match the catalog at https://api.featherless.ai/v1/models —
# several listed models return no_response at inference time, so verify with a
# real chat completion, not just the catalog. Featherless also limits how many
# distinct models an account can switch between, so one model for both roles.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_ORCHESTRATOR_MODEL=Qwen/Qwen3-32B
FEATHERLESS_SPECIALIST_MODEL=Qwen/Qwen3-32B

# --- Nebius Token Factory (NVIDIA Nemotron, OpenAI-compatible) ---------------
# AGENT_PROVIDER=nebius runs the whole crew on Nemotron open models; also the
# configured AGENT_PROVIDER_FALLBACK. Check current catalog IDs before a run.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_ORCHESTRATOR_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_SPECIALIST_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Tavily (optional live web search for the researcher) ---------------------
# Gives Jun a searchWeb tool alongside searchScience — live guidance and
# destination practicalities; web hits inform the read but are never citable.
TAVILY_API_KEY=

# SandBase — free during its API Free Week (no end date published); proxies
# Tavily/Firecrawl. With a key set, search falls back between native and
# SandBase automatically; SEARCH_ROUTE_ORDER picks which is tried first.
# SANDBASE_API_KEY=
# SANDBASE_BASE_URL=https://api.sandbase.ai
# SEARCH_ROUTE_ORDER=native,sandbase   # or sandbase,native

# --- Qloo (optional destination taste for the planner) -----------------------
# Hackathon keys work ONLY against hackathon.api.qloo.com (X-Api-Key header).
# Gives Otto destinationTaste — venues/categories the destination is known
# for, to ground plan notes. Never touches timing or the scorer.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Firecrawl (optional second science provider) ----------------------------
FIRECRAWL_API_KEY=

# --- Supabase (optional persistence layer) ------------------------------
# Run history/check-ins in the database instead of browser localStorage.
# Table spec in src/tools/supabase.ts; schema in supabase/migrations/
# (supabase link --project-ref <ref> && supabase db push).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Composio → real Google Calendar (optional) ------------------------------
# MCP consumer key (x-consumer-api-key from dashboard → MCP URL) — already
# bound to the connected Google account, no project key or entity id needed.
# proposeMove patches real events; commitPlan writes intervention blocks.
# CALENDAR_BACKEND=fixture forces fixtures even with the key present.
COMPOSIO_API_KEY=
CALENDAR_BACKEND=
GOOGLE_CALENDAR_ID=primary
MERIDIAN_CALENDAR_TZ=Europe/London

# --- ElevenLabs (optional voice layer) ---------------------------------------
# POST /api/voice streams raw PCM per crew member; chunk-sized jobs enqueue as
# tokens arrive so the crew talks while still "thinking". Audio is cached by
# content hash in memory + Supabase Storage (replay runs are instant + free).
# {lines:[{agent,text}]} runs multi-voice text-to-dialogue for the handoff.
# Defaults in src/lib/voice/config.ts; per-seat voice override:
# ELEVENLABS_VOICE_<AGENT> (e.g. ELEVENLABS_VOICE_PLANNER) or ELEVENLABS_VOICE_ID.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_v4_turbo        — crew chatter; v4 needed for audio tags
# ELEVENLABS_DIALOGUE_MODEL_ID=eleven_v3     — multi-voice exchanges
# ELEVENLABS_OUTPUT_FORMAT=pcm_22050         — player reads the rate off response headers
# ELEVENLABS_BASE_URL=                        — residency/enterprise endpoint override
# ELEVENLABS_STABILITY=0.45 / ELEVENLABS_SIMILARITY_BOOST=0.75
# MERIDIAN_VOICE_SEED=42                     — fixed seed keeps replays deterministic
# MERIDIAN_VOICE_TAGS=off                    — disables persona audio tags
# MERIDIAN_VOICE_KARAOKE=off                 — disables word-alignment highlighting
# MERIDIAN_VOICE_BUCKET=meridian-voice       — Supabase Storage cache bucket
# MERIDIAN_VOICE_CACHE_BYTES=25165824        — in-memory cache cap

# --- Replay pacing -----------------------------------------------------------
# MS between streamed events in replay mode (default 60; ~300 is narratable).
# REPLAY_BEAT_MS=60

# --- FalkorDB graph memory (optional, Graph Hacks track) ----------------------
# falkor://localhost:6379 — enables cross-run graph memory; unset falls back
# to crew-memory.json. Seed with `bun run seed:graph`.
# FALKORDB_URL=falkor://<user>:<pass>@<host>:<port>
# MERIDIAN_GRAPH_ID=meridian:demo
# MERIDIAN_SESSION=run-2   # label stamped on graph writes (seed uses run-1)
# SEED_ADMIN_TOKEN=        # enables POST /api/graph/seed (x-seed-token header) — required on Render to seed the internal pserv

# Web Push — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Bearer token that protects /api/cron/dispatch (scheduler → server).
CRON_SECRET=
