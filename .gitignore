# Tool session state, same category as .qoder/ above
.commandcode/
.perch/

# Recording stills are regenerable output, not source — and a `git add -A`
# sweep kept dragging them in. The film itself (video/ scripts, audio,
# index.html) stays tracked; only the captures are ignored.
artifacts/video/

# The film is local-only — compositions, audio, renders, lockfiles and agent
# docs all stay out of git. Nothing in the app build reads from video/.
video/

# stray screenshot dumps land here when a tool writes to the repo root
--timeout
--viewport

# Playwright artifacts and laptop-generated baselines never commit.
test-results/
visual/**/*-darwin.png
visual/**/*-actual.png

# Foundry build output — contracts/src is the source, out/ and cache/ regenerate.
contracts/out/
contracts/cache/

# Local design-review captures, logs and baselines — review evidence, not product source.
artifacts/design-review/

# Local prod-capture script for the external qloo entry (videos land outside this repo).
capture.mjs

# One-off review/measure scratch scripts — evidence of a session, not source.
*.tmp.mjs
.tmp-*.mjs
